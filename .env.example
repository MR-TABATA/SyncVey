# Django
# SECRET_KEY: 本番（DEBUG=False）では必須。未設定だと起動を拒否します。
#   生成例: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-secret-key-here
# DEBUG: 本番は必ず False（既定 False）。開発時のみ True。
DEBUG=True
# 本番（DEBUG=False）では公開ホスト名をカンマ区切りで明示
ALLOWED_HOSTS=localhost,127.0.0.1
# HTTPS 配下でフォーム POST する場合（例）: https://syncvey.example.com
# CSRF_TRUSTED_ORIGINS=https://syncvey.example.com

# --- セキュリティ（HTTPS 終端の背後で運用する場合）---
# リバースプロキシが TLS 終端する場合は True
# SECURE_PROXY_SSL_HEADER=True
# HTTP のみで運用する場合は Cookie Secure を明示的に無効化（本番デフォルトは True）
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False
# 全リクエストを HTTPS へ強制リダイレクト
# SECURE_SSL_REDIRECT=True
# HSTS（注意して有効化。秒。例 1 年=31536000）
# SECURE_HSTS_SECONDS=31536000

# Database
# DB_* は Postgres コンテナの初期化に使う。DATABASE_URL と値を必ず一致させること。
DB_NAME=asset_manager
DB_USER=user
DB_PASSWORD=password
# ホストへ公開する Postgres ポート（コンテナ間接続には不要。競合する場合のみ変更）
DB_PORT_EXTERNAL=5432
DATABASE_URL=postgres://user:password@db:5432/asset_manager

# アプリをホストへ公開するポート（任意・既定 8000）
APP_PORT_EXTERNAL=8000

# AWS（中央アカウントの IAM ユーザーキー）
AWS_ACCOUNT_ID=123456789012
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_SCAN_REGIONS=ap-northeast-1

# --- お試しモード: LocalStack（AWS アカウント不要）---
# `docker compose --profile demo up -d` でローカルの AWS エミュレータが起動する。
# 下の 3 行を有効にすると、スキャン先が実 AWS ではなくエミュレータになる。
# ダミーの資格情報で構わない（LocalStack は署名を検証しない）。
# 実 AWS を見る時は必ずコメントアウトへ戻すこと。
# AWS_ENDPOINT_URL=http://localstack:4566
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# LocalStack をホストへ公開するポート（任意・既定 4566）
# LOCALSTACK_PORT_EXTERNAL=4566

# Slack通知（任意）
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# EOL データの外部取得（任意・既定OFF）
#   true にすると endoflife.date へ日次アクセスして EOL データを更新（オプトイン）。
#   OFF のままなら外部通信せず内蔵の静的データで判定する。
EOL_REFRESH_ENABLED=false
#   有効時、取得対象を登録済み依存パッケージから動的導出するか（false で固定セットのみ）。
EOL_REFRESH_DYNAMIC=true

# ドリフト履歴の保持件数（Environment ごと）。スキャン／取込／S3同期のたびに
# 差分ゼロでも1行積むため、未設定だとテーブルが無限に伸びる。0 以下で無制限。
DRIFT_SNAPSHOT_RETENTION=500

# Auto Scaling が湧かせた/消したインスタンスをドリフトとして数えない（cry-wolf対策）。
# 既定 true。false で従来どおり added にカウント。属性変更は常にドリフト扱い。
DRIFT_SUPPRESS_AUTOSCALING=true
